# Copy to .env and fill in. Without a key the lab runs in MOCK mode (offline demo).
LAB_API_PROVIDER=auto
LAB_API_MODEL=
LAB_LANGUAGE=en

LAB_CASE_NAME=StageFinder
LAB_CASE_PROBLEM=students struggle to find internships
LAB_CASE_AUDIENCE=university students
LAB_CASE_CONSTRAINTS=Budget under $500; buildable by students in 8 weeks; plain language.
LAB_CASE_EVIDENCE=12 student interviews and data/feedback.csv; no revenue yet.

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra

DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_TITLE=AI Start-up Lab

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/openai/gpt-oss-20b

NVIDIA_API_KEY=
